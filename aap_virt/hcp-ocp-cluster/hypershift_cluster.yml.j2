apiVersion: project.openshift.io/v1
kind: Project
metadata:
  name: {{ project_namespace }}
---
apiVersion: hypershift.openshift.io/v1beta1
kind: HostedCluster
metadata:
  name: {{ cluster_name }}
  namespace: {{ project_namespace }}
  labels:
    cluster.open-cluster-management.io/clusterset: {{ clusterset }}
spec:
  etcd:
    managed:
      storage:
        persistentVolume:
          size: {{ etcd_storage_size }}
          storageClassName: {{ etcd_storage_class }}
        type: PersistentVolume
    managementType: Managed
  release:
    image: {{ release_image }}
  pullSecret:
    name: pullsecret-cluster-{{ cluster_name }}
  sshKey:
    name: sshkey-cluster-{{ cluster_name }}
  networking:
    clusterNetwork:
      - cidr: {{ cluster_network_cidr }}
    serviceNetwork:
      - cidr: {{ service_network_cidr }}
    networkType: OVNKubernetes
  controllerAvailabilityPolicy: SingleReplica
  infrastructureAvailabilityPolicy: SingleReplica
  platform:
    type: KubeVirt
    kubevirt:
      baseDomainPassthrough: true
  infraID: {{ cluster_name }}
  services:
    - service: OAuthServer
      servicePublishingStrategy:
        type: Route
    - service: OIDC
      servicePublishingStrategy:
        type: Route
    - service: Konnectivity
      servicePublishingStrategy:
        type: Route
    - service: Ignition
      servicePublishingStrategy:
        type: Route
---
apiVersion: v1
kind: Secret
metadata:
  name: pullsecret-cluster-{{ cluster_name }}
  namespace: {{ project_namespace }}
stringData:
  '.dockerconfigjson': {{ rh_registry_tokens | quote }}
type: kubernetes.io/dockerconfigjson
---
apiVersion: v1
kind: Secret
metadata:
  name: sshkey-cluster-{{ cluster_name }}
  namespace: {{ project_namespace }}
stringData:
  'id_rsa.pub': {{ ssh_pubkey | quote }}
---
apiVersion: hypershift.openshift.io/v1beta1
kind: NodePool
metadata:
  name: {{ cluster_name}}-worker
  namespace: {{ project_namespace }}
spec:
  arch: amd64
  clusterName: {{ cluster_name }}
  replicas: {{ worker_replicas }}
  management:
    autoRepair: false
    upgradeType: Replace
  platform:
    type: KubeVirt
    kubevirt:
      compute:
        cores: {{ worker_cores }}
        memory: {{ worker_memory }}
      rootVolume:
        type: Persistent
        persistent:
          size: {{ worker_disk }}
      defaultPodNetwork: true
  release:
    image: {{ release_image }}
---
apiVersion: cluster.open-cluster-management.io/v1
kind: ManagedCluster
metadata:
  annotations:
    import.open-cluster-management.io/hosting-cluster-name: local-cluster 
    import.open-cluster-management.io/klusterlet-deploy-mode: Hosted
    open-cluster-management/created-via: hypershift
  labels:
    cloud: BareMetal
    vendor: OpenShift
    name: {{ cluster_name }}
    cluster.open-cluster-management.io/clusterset: {{ clusterset }}
  name: {{ cluster_name }}
spec:
  hubAcceptsClient: true
---
apiVersion: agent.open-cluster-management.io/v1
kind: KlusterletAddonConfig
metadata:
  name: {{ cluster_name }}
  namespace: {{ cluster_name }}
spec:
  clusterName: {{ cluster_name }}
  clusterNamespace: {{ cluster_name }}
  clusterLabels:
    cloud: BareMetal
    vendor: OpenShift
  applicationManager:
    enabled: true
  policyController:
    enabled: true
  searchCollector:
    enabled: true
  certPolicyController:
    enabled: true


